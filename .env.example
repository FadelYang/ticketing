# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=appdb
POSTGRES_PORT=5432

# Backend Configuration
APP_ENV=development
BACKEND_PORT=8080
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Frontend Configuration
